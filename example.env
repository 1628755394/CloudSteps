# machine
MACHINE_ID=1

# server
SERVER_NAME=解忧
SERVER_URL=
SERVER_DESC=解忧 - 陪练与单词训练平台
SERVER_LOGO=
SERVER_TERMS_URL=

ADDR=:7080
MODE=development

# db
DB_DRIVER=mysql
DSN=

# log / routes
LOG_LEVEL=debug
LOG_FILENAME=logs/CloudSteps.log
LOG_MAX_SIZE=200
LOG_MAX_AGE=30
LOG_MAX_BACKUPS=7
LOG_DAILY=true
DOCS_PREFIX=/api/docs
API_PREFIX=/api
ADMIN_PREFIX=/admin
AUTH_PREFIX=/auth

# auth
SESSION_SECRET=
SESSION_EXPIRE_DAYS=7
AUTH_HEADER=Authorization
# 登录 token 有效期（Go duration：必须用 h/m/s，不能写 7d）
AUTH_TOKEN_EXPIRED=168h

# mail（当前走 SMTP；未使用 SendCloud）
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PORT=587
MAIL_FROM_EMAIL=

# LLM（文本 / 复盘）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=https://ai.lingecho.com
IMAGE_GEN_MODEL=gpt-image-2-1k
# 词库 AI 封面水印中文字体（.ttf / .otf / .ttc）；Linux 部署建议配置 Noto CJK 路径
COVER_WATERMARK_FONT=

# TTS（统一工厂 pkg/synthesizer；默认 qcloud）
TTS_PROVIDER=qcloud
# 腾讯云 TTS 多账号（JSON 数组；音色固定默认 1005，无需配置 voiceType）
# 字段：appId / secretId / secret（也兼容 app_id / secret_id / secret_key）
QCLOUD_TTS_ACCOUNTS=[{"appId":"","secretId":"","secret":""}]
# 每账号最多同时生成的词库数；总并发 = 账号数 × 该值，超出任务排队（ling-base/queue）
WORDBOOK_BATCH_AUDIO_PER_ACCOUNT=9
# 单词 TTS 失败重试：额外重试次数（默认 2 → 共 3 次）；退避基数毫秒（默认 800）
WORDBOOK_TTS_MAX_RETRIES=2
WORDBOOK_TTS_RETRY_BASE_MS=800

# Realtime 情景口语（扁平配置即可，无需再叠 REALTIME_CONFIG_JSON）
REALTIME_PROVIDER=
REALTIME_API_KEY=
REALTIME_MODEL=
DASHSCOPE_API_KEY=

# cache
CACHE_TYPE=local
LOCAL_CACHE_MAX_SIZE=1000
LOCAL_CACHE_DEFAULT_EXPIRATION=5m

# storage（七牛）
STORAGE_KIND=
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
QINIU_PRIVATE=false
QINIU_REGION=

SSL_ENABLED=false
