# machine
MACHINE_ID=1

# server
SERVER_NAME=云阶
SERVER_URL=
SERVER_DESC=云阶 - 陪练与单词训练平台
SERVER_LOGO=
SERVER_TERMS_URL=

ADDR=:7080
MODE=development

# db
DB_DRIVER=mysql
DSN=

# log / routes
LOG_LEVEL=debug
LOG_FILENAME=logs/CloudSteps.log
LOG_MAX_SIZE=200
LOG_MAX_AGE=30
LOG_MAX_BACKUPS=7
LOG_DAILY=true
DOCS_PREFIX=/api/docs
API_PREFIX=/api
ADMIN_PREFIX=/admin
AUTH_PREFIX=/auth

# auth
SESSION_SECRET=
SESSION_EXPIRE_DAYS=7
AUTH_HEADER=Authorization

# mail（当前走 SMTP；未使用 SendCloud）
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PORT=587
MAIL_FROM_EMAIL=

# LLM（文本 / 复盘）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 腾讯云 TTS（管理端 / cmd/tts-gen）
QCLOUD_APP_ID=
QCLOUD_SECRET_ID=
QCLOUD_SECRET=
QCLOUD_VOICE_TYPE=

# Realtime 情景口语（扁平配置即可，无需再叠 REALTIME_CONFIG_JSON）
REALTIME_PROVIDER=
REALTIME_API_KEY=
REALTIME_MODEL=
DASHSCOPE_API_KEY=

# cache
CACHE_TYPE=local
LOCAL_CACHE_MAX_SIZE=1000
LOCAL_CACHE_DEFAULT_EXPIRATION=5m

# storage（七牛）
STORAGE_KIND=
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
QINIU_PRIVATE=false
QINIU_REGION=

SSL_ENABLED=false
