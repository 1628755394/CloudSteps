# h5.lingecho.com — 宝塔站点配置示例（含维护模式）
#
# 部署文件：
#   /www/wwwroot/h5.lingecho.com/dist/              # 前端构建产物
#   /www/wwwroot/h5.lingecho.com/maintenance.html   # 维护页（勿放进 dist）
#   /www/wwwroot/h5.lingecho.com/logo.png           # 维护页 logo（同源本地）
#   /www/wwwroot/h5.lingecho.com/wechat-biz-qr.png  # 客服二维码（同源本地）
#   /www/wwwroot/h5.lingecho.com/maintenance.on     # 存在即开启维护（空文件即可）
#
# 开关：
#   开启：touch /www/wwwroot/h5.lingecho.com/maintenance.on && nginx -t && nginx -s reload
#   关闭：rm  -f /www/wwwroot/h5.lingecho.com/maintenance.on && nginx -t && nginx -s reload
#
# 预览维护页：https://h5.lingecho.com/maintenance.html
#
# 为何 dist 不存在时会 500？
#   nginx 的 root 若指向不存在的目录，打开文件阶段会直接 500，不会走到你的 try_files。
#   下面用「无 dist/index.html 则自动维护」避开这个问题。

server
{
    listen 80;
    listen 443 ssl;
    listen 443 quic;
    listen [::]:443 ssl;
    listen [::]:443 quic;
    http2 on;
    listen [::]:80;
    server_name h5.lingecho.com;
    index index.html index.htm default.htm default.html;
    # 站点根用「有目录的」父路径；SPA 在各 location 里再指向 dist
    # （若 server root 直接写 .../dist 且目录不存在，访问 / 常直接 500）
    root /www/wwwroot/h5.lingecho.com;
    include /www/server/panel/vhost/nginx/extension/h5.lingecho.com/*.conf;

    #CERT-APPLY-CHECK--START
    include /www/server/panel/vhost/nginx/well-known/h5.lingecho.com.conf;
    #CERT-APPLY-CHECK--END

    #SSL-START
    #error_page 404/404.html;
    set $isRedcert 1;
    if ($server_port != 443) {
        set $isRedcert 2;
    }
    if ( $uri ~ /\.well-known/ ) {
        set $isRedcert 1;
    }
    if ($isRedcert != 1) {
        rewrite ^(/.*)$ https://$host$1 permanent;
    }
    ssl_certificate    /www/server/panel/vhost/cert/h5.lingecho.com/fullchain.pem;
    ssl_certificate_key    /www/server/panel/vhost/cert/h5.lingecho.com/privkey.pem;
    ssl_protocols TLSv1.1 TLSv1.2 TLSv1.3;
    ssl_ciphers EECDH+CHACHA20:EECDH+CHACHA20-draft:EECDH+AES128:RSA+AES128:EECDH+AES256:RSA+AES256:EECDH+3DES:RSA+3DES:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_tickets on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000";
    add_header Alt-Svc 'quic=":443"; h3=":443"; h3-29=":443"; h3-27=":443";h3-25=":443"; h3-T050=":443"; h3-Q050=":443";h3-Q049=":443";h3-Q048=":443"; h3-Q046=":443"; h3-Q043=":443"';
    error_page 497  https://$host$request_uri;
    #SSL-END

    #REWRITE-START
    include /www/server/panel/vhost/rewrite/html_h5.lingecho.com.conf;
    #REWRITE-END

    # ---------- 维护模式 ----------
    # 1) 手动开关  2) 尚未发布前端（无 dist/index.html）时自动进入，避免 500
    set $maintenance_mode 0;
    if (-f /www/wwwroot/h5.lingecho.com/maintenance.on) {
        set $maintenance_mode 1;
    }
    if (!-f /www/wwwroot/h5.lingecho.com/dist/index.html) {
        set $maintenance_mode 1;
    }

    # 维护页本体（放在 dist 外，发布前端不会覆盖）
    location = /maintenance.html {
        root /www/wwwroot/h5.lingecho.com;
        add_header Cache-Control "no-store" always;
        charset utf-8;
    }

    # 维护页同源静态资源（精确匹配优先于下方图片正则，维护期也可访问）
    location = /logo.png {
        root /www/wwwroot/h5.lingecho.com;
        access_log off;
        add_header Cache-Control "public, max-age=86400";
    }
    location = /wechat-biz-qr.png {
        root /www/wwwroot/h5.lingecho.com;
        access_log off;
        add_header Cache-Control "public, max-age=86400";
    }

    # 主动维护 / 上游异常 / 无 dist 自动维护 → 统一落到维护页
    error_page 502 503 504 /maintenance.html;

    location ~ ^/(\.user.ini|\.htaccess|\.git|\.env|\.svn|\.project|LICENSE|README.md)
    {
        return 404;
    }

    location ~ \.well-known{
        allow all;
    }

    if ( $uri ~ "^/\.well-known/.*\.(php|jsp|py|js|css|lua|ts|go|zip|tar\.gz|rar|7z|sql|bak)$" ) {
        return 403;
    }

    # Reverse proxy for /api
    location /api {
        if ($maintenance_mode = 1) {
            add_header Content-Type "application/json; charset=utf-8" always;
            add_header Cache-Control "no-store" always;
            return 503 '{"code":503,"msg":"系统维护中，请稍后再试","data":{"maintenance":true},"status":"maintenance"}';
        }

        proxy_pass http://127.0.0.1:7080/api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_intercept_errors off;
    }

    # 静态资源必须显式 root 到 dist；维护期先 503，避免去 open 不存在的目录
    location ~* \.(gif|jpg|jpeg|png|bmp|swf)$
    {
        if ($maintenance_mode = 1) {
            return 503;
        }
        root /www/wwwroot/h5.lingecho.com/dist;
        expires      30d;
        error_log /dev/null;
        access_log /dev/null;
    }

    location ~* \.(js|css)$
    {
        if ($maintenance_mode = 1) {
            return 503;
        }
        root /www/wwwroot/h5.lingecho.com/dist;
        expires      12h;
        error_log /dev/null;
        access_log /dev/null;
    }

    location / {
        if ($maintenance_mode = 1) {
            return 503;
        }
        root /www/wwwroot/h5.lingecho.com/dist;
        try_files $uri $uri/ /index.html;
    }

    access_log  /www/wwwlogs/h5.lingecho.com.log;
    error_log  /www/wwwlogs/h5.lingecho.com.error.log;
}
