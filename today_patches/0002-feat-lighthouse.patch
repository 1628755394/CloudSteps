diff --git a/web/src/components/MemoryLighthouse.tsx b/web/src/components/MemoryLighthouse.tsx
index 93c9b78..6390526 100644
--- a/web/src/components/MemoryLighthouse.tsx
+++ b/web/src/components/MemoryLighthouse.tsx
@@ -3,6 +3,11 @@
  *
  * 灵感来源：李校来啦 (lxll.com) 的 WordGrid 九宫格
  * 适配 CloudSteps 的 React + Tailwind 技术栈
+ *
+ * 数字落点按 nine_grid_alt.png 圆环扇区标定（图 1190×1322）：
+ *   01    → 待学（pending）
+ *   02–08 → 复习阶段 boxes[0–6]
+ *   09    → 已掌握（mastered）
  */
 
 import { useCallback, useMemo } from "react";
@@ -23,6 +28,31 @@ interface MemoryLighthouseProps {
   onBlockClick?: (type: string, wordNum: number, tips: string) => void;
 }
 
+type SlotKind = "box" | "unlearned" | "mastered";
+
+interface RingSlot {
+  /** 相对图片宽高的中心 % */
+  left: number;
+  top: number;
+  kind: SlotKind;
+  /** boxes 下标；仅 kind=box 时有效 */
+  boxIndex?: number;
+  tips: string;
